# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env в репозиторий не коммитится — в нём токен.

# Обязательно. Токен от @BotFather.
BOT_TOKEN=123456789:AAH...

# Необязательно. Куда присылать заявки из бота.
# Как узнать свой ID: напишите @userinfobot в Telegram, он ответит числом.
ADMIN_CHAT_ID=
